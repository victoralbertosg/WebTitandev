---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TitanDevDataDynamics — Ingeniería de Software, IA & Data Science",
  description = "TitanDevDataDynamics — Ingeniería de software avanzada, Inteligencia Artificial, Ciencia de Datos y Big Data. Transformamos datos en decisiones estratégicas para tu negocio."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="inteligencia artificial, ciencia de datos, big data, machine learning, desarrollo de software, consultoría tecnológica, cloud computing, colombia" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="robots" content="index, follow" />
  <title>{title}</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/responsive.css" />

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "TitanDevDataDynamics",
    "description": "Ingeniería de software avanzada, IA, Ciencia de Datos y Big Data",
    "url": "https://titandevdatadynamics.com",
    "serviceType": ["Inteligencia Artificial", "Big Data", "Ciencia de Datos", "Desarrollo de Software"]
  }
  </script>
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <nav class="navbar" id="navbar" role="navigation" aria-label="Navegación principal">
    <div class="nav-container">
      <a href="/" class="nav-logo" id="nav-logo-link" aria-label="TitanDevDataDynamics inicio">
        <img src="/assets/images/logo.png" alt="TitanDevDataDynamics Logo" class="logo-img" />
        <span class="logo-text">Titan<span class="logo-accent">Dev</span>DataDynamics</span>
      </a>

      <ul class="nav-menu" id="nav-menu" role="menubar">
        <li role="none"><a href="/#servicios" class="nav-link" role="menuitem">Servicios</a></li>
        <li role="none"><a href="/#tecnologias" class="nav-link" role="menuitem">Tecnologías</a></li>
        <li role="none"><a href="/#portafolio" class="nav-link" role="menuitem">Portafolio</a></li>
        <li role="none"><a href="/#proceso" class="nav-link" role="menuitem">Proceso</a></li>
        <li role="none"><a href="/#nosotros" class="nav-link" role="menuitem">Nosotros</a></li>
        <li role="none"><a href="/blog" class="nav-link" role="menuitem">Blog Insights</a></li>
        <li role="none"><a href="/calculadora-roi" class="nav-link" role="menuitem">Calculadora ROI</a></li>
        <li role="none"><a href="/demos" class="nav-link" role="menuitem">Demos IA</a></li>
        <li role="none"><a href="/#contacto" class="nav-link nav-cta" id="nav-cta-btn" role="menuitem">Consulta Gratuita</a></li>
      </ul>

      <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <slot />

  <!-- ===== FOOTER ===== -->
  <footer class="footer" role="contentinfo">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="nav-logo" aria-label="TitanDevDataDynamics - Inicio">
            <img src="/assets/images/logo.png" alt="TitanDevDataDynamics Logo" class="logo-img" />
            <span class="logo-text">Titan<span class="logo-accent">Dev</span>DataDynamics</span>
          </a>
          <p class="footer-tagline">Transformamos datos en decisiones estratégicas. Ingeniería de software, IA y Big Data para empresas que quieren liderar.</p>
          <div class="footer-socials" aria-label="Redes sociales">
            <a href="https://linkedin.com/company/titandatasolution" target="_blank" rel="noopener noreferrer" class="social-link" id="footer-linkedin" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="https://github.com/victoralbertosg/WebTitandev" target="_blank" rel="noopener noreferrer" class="social-link" id="footer-github" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Servicios</h4>
          <ul class="footer-links" role="list">
            <li><a href="/#servicios" class="footer-link">Inteligencia Artificial</a></li>
            <li><a href="/#servicios" class="footer-link">Ciencia de Datos</a></li>
            <li><a href="/#servicios" class="footer-link">Big Data & ETL</a></li>
            <li><a href="/#servicios" class="footer-link">Visión Artificial (YOLO11)</a></li>
            <li><a href="/#servicios" class="footer-link">IA On-Premise (Llama 3.3)</a></li>
            <li><a href="/#servicios" class="footer-link">Microservicios Cloud-Native</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Innovación V2</h4>
          <ul class="footer-links" role="list">
            <li><a href="/blog" class="footer-link">Blog Insights (MDX)</a></li>
            <li><a href="/calculadora-roi" class="footer-link">Calculadora ROI (React)</a></li>
            <li><a href="/demos" class="footer-link">Demos Interactivas IA</a></li>
            <li><a href="/llms.txt" target="_blank" class="footer-link">📄 Especificación LLMs.txt (GEO)</a></li>
            <li><a href="/ai.json" target="_blank" class="footer-link">🤖 Schema AI JSON-LD</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Contacto Rápido</h4>
          <ul class="footer-links" role="list">
            <li><a href="mailto:info@titandatasolution.com" class="footer-link">✉️ info@titandatasolution.com</a></li>
            <li><a href="https://wa.me/573000000000" target="_blank" rel="noopener noreferrer" class="footer-link">💬 WhatsApp Business</a></li>
          </ul>
          <div class="footer-cta-box">
            <p>¿Proyecto en mente?</p>
            <a href="/#contacto" class="btn btn-primary btn-sm" id="footer-cta-btn">Solicitar Propuesta</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">© 2026 TitanDevDataDynamics. Todos los derechos reservados.</p>
        <div class="footer-legal" role="list">
          <a href="#" class="footer-link-sm" role="listitem">Política de Privacidad</a>
          <a href="#" class="footer-link-sm" role="listitem">Términos de Servicio</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- BACK TO TOP -->
  <button class="back-to-top" id="back-to-top-btn" aria-label="Volver al inicio">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg>
  </button>

  <!-- Interactive Scripts -->
  <script is:inline src="/js/particles.js"></script>
  <script is:inline src="/js/animations.js"></script>
  <script is:inline src="/js/main.js"></script>
</body>
</html>
