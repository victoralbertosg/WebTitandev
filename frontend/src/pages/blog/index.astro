---
/*
===============================================================================
 TitanDevDataDynamics — Página Principal del Blog Técnico ("Titan Insights")
===============================================================================
 Este componente obtiene dinámicamente todos los artículos almacenados en
 src/content/blog/, los ordena por fecha y los presenta en una grilla atractiva.
===============================================================================
*/

import { getCollection } from 'astro:content';

// Obtener todas las publicaciones del blog y ordenarlas por fecha (más reciente primero)
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Titan Tech Insights — Blog de Ingeniería, IA & Data Lakehouses</title>
  <meta name="description" content="Artículos técnicos especializados sobre Ingeniería de Contexto, RAG Enterprise, Apache Iceberg, Tokenomics y Microservicios." />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
  
  <style>
    .blog-hero {
      padding: var(--space-5xl) 0 var(--space-3xl);
      text-align: center;
      background: radial-gradient(circle at top, rgba(124, 58, 237, 0.15) 0%, transparent 70%);
    }
    
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-xl);
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-2xl) var(--space-lg);
    }
    
    .blog-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(12px);
      border: 1px solid var(--color-glass-border);
      border-radius: var(--radius-lg);
      padding: var(--space-xl);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
    }
    
    .blog-card:hover {
      transform: translateY(-6px);
      border-color: rgba(124, 58, 237, 0.4);
      box-shadow: 0 12px 30px rgba(124, 58, 237, 0.15);
    }
    
    .blog-card-title {
      font-family: var(--font-heading);
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      margin: 12px 0;
      line-height: 1.3;
    }
    
    .blog-card-desc {
      color: var(--color-slate);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: var(--space-md);
    }
    
    .tag-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: rgba(0, 212, 255, 0.12);
      border: 1px solid rgba(0, 212, 255, 0.25);
      color: var(--color-cyan);
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    .blog-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--color-slate-muted);
      font-size: 0.825rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: var(--space-sm);
      margin-top: var(--space-md);
    }
  </style>
</head>
<body>
  <header class="blog-hero">
    <a href="/" style="color: var(--color-cyan); text-decoration: none; font-weight: 600; font-size: 0.9rem;">← Volver al Inicio</a>
    <h1 style="font-family: var(--font-heading); font-size: 3rem; font-weight: 800; color: #fff; margin-top: 12px;">Titan Tech Insights</h1>
    <p style="color: var(--color-slate); max-width: 650px; margin: 12px auto 0; font-size: 1.1rem;">
      Investigación, arquitecturas de software y lecciones de producción en Inteligencia Artificial, Data Lakehouses y Cloud-Native.
    </p>
  </header>

  <main>
    <div class="blog-grid">
      {sortedPosts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              {post.data.tags.map(tag => <span class="tag-badge">{tag}</span>)}
            </div>
            <h2 class="blog-card-title">{post.data.title}</h2>
            <p class="blog-card-desc">{post.data.description}</p>
          </div>
          
          <div class="blog-card-footer">
            <span>⏱️ {post.data.min_read}</span>
            <time>{new Date(post.data.pubDate).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
          </div>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
